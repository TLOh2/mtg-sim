# Forge build output (submodule itself is tracked via .gitmodules; its own
# build artifacts are not committed)
engine/.runtime-classpath.txt
engine/forge/**/target/
engine/runtime-libs/

# Assembled downloadable Windows package (portable runtimes + built output -
# see scripts/build-windows-package.sh) - a build artifact, not source.
dist-package/

# Cached portable Node/JRE downloads used to assemble dist-package/ (see
# scripts/fetch-runtimes.sh) - large binaries, not source, fetched once and
# reused across packaging runs rather than re-downloaded every time.
vendor/

# Node
node_modules/
dist/
.env
.env.local

# Simulation run artifacts (raw logs / generated decks are data, not code -
# revisit if we want to commit sample fixtures deliberately)
data/runs/*
!data/runs/.gitkeep

# Decks pasted through the dashboard get auto-saved here for reuse - NOT
# committed (this is user-generated data, not source, and lives only as
# long as the current deploy does - see server/src/decks/deckLibrary.ts).
# Deliberately baked-in decks live in server/presets/decks/ instead, which
# IS committed.
data/decks/*
!data/decks/.gitkeep

# Card name -> type lookup cache (see server/src/cardTypes/lookupCardTypes.ts)
# - regenerable from Forge's own card database via engine/run-cardtypes.sh,
# not source.
data/card-types-cache.json

# OS/editor cruft
.DS_Store
*.log
